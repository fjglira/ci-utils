# OSSM Release Confidence Score Environment Configuration (Red Hat Vertex AI)
# Copy this file to .env and customize for your build analysis

# === AUTHENTICATION SETUP ===
# This container uses Red Hat's Vertex AI setup instead of direct Claude API keys
# You need:
# 1. GCP Service Account Key (JSON file) - same one you use for Claude Code CLI
# 2. Your team's GCP Project ID from the Red Hat spreadsheet

# SECURE METHOD (Recommended): Use secret files
# Run: ./create-secrets.sh to set up all secret files securely
# Or manually:
#   mkdir -p secrets
#   cp /path/to/your-gcp-service-account.json secrets/gcp-sa-key.json
#   chmod 600 secrets/*

# === REQUIRED VARIABLES ===

# GCP Project ID - get this from your Claude Code CLI setup
# Check your ~/.bashrc or ~/.zshrc for ANTHROPIC_VERTEX_PROJECT_ID
# Or look at the Red Hat spreadsheet mentioned in the Claude setup guide
GCP_PROJECT_ID=your-team-project-id-here

# Build identifier - Use either BUILD_ID or RELEASE_CANDIDATE
BUILD_ID=OSSM-3.1.0-RC1
# RELEASE_CANDIDATE=3.1.0-RC1

# Change type determines test scope requirements
# FULL  = New minor OSSM versions, requires complete test matrix
# CORE  = Code changes, CVE fixes, Istio updates
# BASIC = Auto base image updates
CHANGE_TYPE=FULL

# === OPTIONAL VARIABLES ===

# OSSM version being tested (auto-detected if not specified)
OSSM_VERSION=3.1.0

# Target confidence threshold (1-10 scale)
CONFIDENCE_THRESHOLD=8

# Focus on specific testing stage
# Options: upstream, midstream, downstream, or leave empty for all
TESTING_STAGE=

# === REPORT PORTAL CONFIGURATION ===
# Usually configured via MCP server, but can be overridden

# SECURE METHOD (Recommended): Use secret files
# echo "https://your-reportportal.com" > secrets/reportportal_url
# echo "your-token-here" > secrets/reportportal_token

# ALTERNATIVE: Environment variables (less secure)
# REPORTPORTAL_URL=https://your-reportportal.com
# REPORTPORTAL_TOKEN=your-token-here

# Report Portal project name
REPORTPORTAL_PROJECT=osssm_general

# === REPOSITORY CONFIGURATION ===
# The container fetches the latest methodology from this repository
# Configure these if your repository URL or branch is different

# Repository URL for fetching latest prompts (update with your actual repo)
CI_UTILS_REPO_URL=https://github.com/your-org/ci-utils.git

# Repository branch to fetch from
CI_UTILS_BRANCH=main

# === USAGE EXAMPLES ===

# Using secret files (recommended):
# docker run --rm \
#   --mount type=bind,source="$(pwd)/secrets/gcp-sa-key.json",target=/run/secrets/gcp_service_account_key,readonly \
#   -e GCP_PROJECT_ID="$GCP_PROJECT_ID" \
#   -e BUILD_ID="$BUILD_ID" \
#   -e CHANGE_TYPE="$CHANGE_TYPE" \
#   -v $(pwd)/reports:/app/reports \
#   quay.io/your-org/ossm-confidence:latest

# === EXAMPLE CONFIGURATIONS ===

# Full scope release testing:
# GCP_PROJECT_ID=ossm-team-project-123
# CHANGE_TYPE=FULL
# OSSM_VERSION=3.2.0
# CONFIDENCE_THRESHOLD=9

# Core changes testing:
# GCP_PROJECT_ID=ossm-team-project-123
# CHANGE_TYPE=CORE
# CONFIDENCE_THRESHOLD=8

# Basic image update testing:
# GCP_PROJECT_ID=ossm-team-project-123
# CHANGE_TYPE=BASIC
# CONFIDENCE_THRESHOLD=7